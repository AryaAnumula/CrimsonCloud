digraph schema {
graph [bgcolor="white",fontname="Arial",fontsize=24,pad="0.55",nodesep="0.6",ranksep="1.2",rankdir=LR,splines=polyline,labelloc=t,labeljust=l,
label="BLOOD BANK MANAGEMENT SYSTEM\nMySQL 8.4 / relational schema / all 11 domain tables\n\nArrow: foreign key → referenced primary key | PK primary key | FK foreign key | UQ unique | ? nullable FK\nUQ* = case-insensitive unique via MySQL collation; nullable donor emails are allowed. Technical security/audit tables are documented separately."];
node [shape=plain,fontname="Arial"]; edge [color="#71869c",arrowsize=0.7,penwidth=1.2];
blood_group [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#c4d0db"><TR><TD COLSPAN="3" BGCOLOR="#e5f2fc"><FONT POINT-SIZE="17"><B>BLOOD_GROUP</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="blood_group_id_in" BGCOLOR="#f9fafb"><FONT POINT-SIZE="12">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13"><U>blood_group_id</U></FONT></TD><TD ALIGN="LEFT" PORT="blood_group_id"><FONT POINT-SIZE="11" COLOR="#596a78">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="group_name_in" BGCOLOR="#f9fafb"><FONT POINT-SIZE="12">UQ</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">group_name</FONT></TD><TD ALIGN="LEFT" PORT="group_name"><FONT POINT-SIZE="11" COLOR="#596a78">varchar(3)</FONT></TD></TR></TABLE>>];
