staff [shape=box,style="filled",fillcolor="#e5f2fc",label="STAFF",margin="0.18,0.12"];
staff_a0 [shape=ellipse,style=filled,fillcolor="#ffffff",label=<<U>staff_id</U>>,fontsize=12,margin="0.09,0.05"]; staff -> staff_a0 [color="#c1cbd5",weight=1];
staff_a1 [shape=ellipse,style=filled,fillcolor="#ffffff",label="name",fontsize=12,margin="0.09,0.05"]; staff -> staff_a1 [color="#c1cbd5",weight=1];
