digraph er {
graph [bgcolor="white",fontname="Arial",fontsize=22,pad="0.5",nodesep="0.38",ranksep="0.8",splines=polyline,overlap=false, dpi=100,rankdir=LR,labelloc=t,labeljust=l,
label="BLOOD BANK MANAGEMENT SYSTEM\n02 / Donors, collection and staff attributes\n\nChen notation: rectangle = entity | diamond = relationship | ellipse = attribute | underline = primary key\n(min,max) gives participation; double line = mandatory. Gray entities are references to another sheet."];
node [fontname="Arial",fontsize=14,color="#486078",penwidth=1.3]; edge [fontname="Arial",fontsize=12,color="#75899d",penwidth=1.1,dir=none];
blood_group [shape=box,style="filled",fillcolor="#e5f2fc",label="BLOOD_GROUP",margin="0.18,0.12"];
blood_group_a0 [shape=ellipse,style=filled,fillcolor="#ffffff",label=<<U>blood_group_id</U>>,fontsize=12,margin="0.09,0.05"]; blood_group -> blood_group_a0 [color="#c1cbd5",weight=1];
blood_group_a1 [shape=ellipse,style=filled,fillcolor="#ffffff",label="group_name",fontsize=12,margin="0.09,0.05"]; blood_group -> blood_group_a1 [color="#c1cbd5",weight=1];
donor [shape=box,style="filled",fillcolor="#e5f2fc",label="DONOR",margin="0.18,0.12"];
