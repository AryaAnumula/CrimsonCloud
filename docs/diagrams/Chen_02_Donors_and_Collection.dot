donor_a6 [shape=ellipse,style=filled,fillcolor="#ffffff",label="email",fontsize=12,margin="0.09,0.05"]; donor -> donor_a6 [color="#c1cbd5",weight=1];
donor_a7 [shape=ellipse,style=filled,fillcolor="#ffffff",label="address",fontsize=12,margin="0.09,0.05"]; donor -> donor_a7 [color="#c1cbd5",weight=1];
donation [shape=box,style="filled",fillcolor="#e5f2fc",label="DONATION",margin="0.18,0.12"];
donation_a0 [shape=ellipse,style=filled,fillcolor="#ffffff",label=<<U>donation_id</U>>,fontsize=12,margin="0.09,0.05"]; donation -> donation_a0 [color="#c1cbd5",weight=1];
donation_a2 [shape=ellipse,style=filled,fillcolor="#ffffff",label="collected_at",fontsize=12,margin="0.09,0.05"]; donation -> donation_a2 [color="#c1cbd5",weight=1];
