blood_group -> r0 [label="(0,N)",color="#75899d",weight=3];
r0 -> donor [label="(1,1)",color="#75899d:#75899d",weight=3];
r1 [shape=diamond,label="makes",fillcolor="#fff5df",style=filled,fontsize=12,margin="0.08,0.06"];
donor -> r1 [label="(0,N)",color="#75899d",weight=3];
