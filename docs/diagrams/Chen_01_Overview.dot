digraph er {
graph [bgcolor="white",fontname="Arial",fontsize=22,pad="0.5",nodesep="0.38",ranksep="0.8",splines=polyline,overlap=false, dpi=100,rankdir=LR,labelloc=t,labeljust=l,
label="BLOOD BANK MANAGEMENT SYSTEM\n01 / Complete relationship map (attributes on sheets 02–04)\n\nChen notation: rectangle = entity | diamond = relationship | ellipse = attribute | underline = primary key\n(min,max) gives participation; double line = mandatory. Gray entities are references to another sheet."];
node [fontname="Arial",fontsize=14,color="#486078",penwidth=1.3]; edge [fontname="Arial",fontsize=12,color="#75899d",penwidth=1.1,dir=none];
