digraph er {
graph [bgcolor="white",fontname="Arial",fontsize=22,pad="0.5",nodesep="0.38",ranksep="0.8",splines=polyline,overlap=false, dpi=100,rankdir=LR,labelloc=t,labeljust=l,
label="BLOOD BANK MANAGEMENT SYSTEM\n03 / Units, storage and testing attributes\n\nChen notation: rectangle = entity | diamond = relationship | ellipse = attribute | underline = primary key\n(min,max) gives participation; double line = mandatory. Gray entities are references to another sheet."];
node [fontname="Arial",fontsize=14,color="#486078",penwidth=1.3]; edge [fontname="Arial",fontsize=12,color="#75899d",penwidth=1.1,dir=none];
blood_unit [shape=box,style="filled",fillcolor="#e5f2fc",label="BLOOD_UNIT",margin="0.18,0.12"];
blood_unit_a0 [shape=ellipse,style=filled,fillcolor="#ffffff",label=<<U>unit_id</U>>,fontsize=12,margin="0.09,0.05"]; blood_unit -> blood_unit_a0 [color="#c1cbd5",weight=1];
blood_unit_a4 [shape=ellipse,style=filled,fillcolor="#ffffff",label="volume_ml",fontsize=12,margin="0.09,0.05"]; blood_unit -> blood_unit_a4 [color="#c1cbd5",weight=1];
blood_unit_a5 [shape=ellipse,style=filled,fillcolor="#ffffff",label="expires_at",fontsize=12,margin="0.09,0.05"]; blood_unit -> blood_unit_a5 [color="#c1cbd5",weight=1];
blood_unit_a6 [shape=ellipse,style=filled,fillcolor="#ffffff",label="status",fontsize=12,margin="0.09,0.05"]; blood_unit -> blood_unit_a6 [color="#c1cbd5",weight=1];
blood_unit_a7 [shape=ellipse,style=filled,fillcolor="#ffffff",label="created_at",fontsize=12,margin="0.09,0.05"]; blood_unit -> blood_unit_a7 [color="#c1cbd5",weight=1];
storage [shape=box,style="filled",fillcolor="#e5f2fc",label="STORAGE",margin="0.18,0.12"];
storage_a0 [shape=ellipse,style=filled,fillcolor="#ffffff",label=<<U>storage_id</U>>,fontsize=12,margin="0.09,0.05"]; storage -> storage_a0 [color="#c1cbd5",weight=1];
storage_a1 [shape=ellipse,style=filled,fillcolor="#ffffff",label="location_name",fontsize=12,margin="0.09,0.05"]; storage -> storage_a1 [color="#c1cbd5",weight=1];
storage_a2 [shape=ellipse,style=filled,fillcolor="#ffffff",label="storage_type",fontsize=12,margin="0.09,0.05"]; storage -> storage_a2 [color="#c1cbd5",weight=1];
storage_a3 [shape=ellipse,style=filled,fillcolor="#ffffff",label="temperature_c",fontsize=12,margin="0.09,0.05"]; storage -> storage_a3 [color="#c1cbd5",weight=1];
storage_a4 [shape=ellipse,style=filled,fillcolor="#ffffff",label="capacity_units",fontsize=12,margin="0.09,0.05"]; storage -> storage_a4 [color="#c1cbd5",weight=1];
storage_a5 [shape=ellipse,style=filled,fillcolor="#ffffff",label="occupied_units",fontsize=12,margin="0.09,0.05"]; storage -> storage_a5 [color="#c1cbd5",weight=1];
storage_a6 [shape=ellipse,style=filled,fillcolor="#ffffff",label="status",fontsize=12,margin="0.09,0.05"]; storage -> storage_a6 [color="#c1cbd5",weight=1];
blood_test [shape=box,style="filled",fillcolor="#e5f2fc",label="BLOOD_TEST",margin="0.18,0.12"];
blood_test_a0 [shape=ellipse,style=filled,fillcolor="#ffffff",label=<<U>test_id</U>>,fontsize=12,margin="0.09,0.05"]; blood_test -> blood_test_a0 [color="#c1cbd5",weight=1];
blood_test_a3 [shape=ellipse,style=filled,fillcolor="#ffffff",label="test_type",fontsize=12,margin="0.09,0.05"]; blood_test -> blood_test_a3 [color="#c1cbd5",weight=1];
blood_test_a4 [shape=ellipse,style=filled,fillcolor="#ffffff",label="result",fontsize=12,margin="0.09,0.05"]; blood_test -> blood_test_a4 [color="#c1cbd5",weight=1];
blood_test_a5 [shape=ellipse,style=filled,fillcolor="#ffffff",label="tested_at",fontsize=12,margin="0.09,0.05"]; blood_test -> blood_test_a5 [color="#c1cbd5",weight=1];
donation [shape=box,style="filled",fillcolor="#f0f1f2",label="DONATION",margin="0.18,0.12"];
blood_group [shape=box,style="filled",fillcolor="#f0f1f2",label="BLOOD_GROUP",margin="0.18,0.12"];
staff [shape=box,style="filled",fillcolor="#f0f1f2",label="STAFF",margin="0.18,0.12"];
r3 [shape=diamond,label="generates",fillcolor="#fff5df",style=filled,fontsize=12,margin="0.08,0.06"];
donation -> r3 [label="(0,1)",color="#75899d",weight=3];
r3 -> blood_unit [label="(1,1)",color="#75899d:#75899d",weight=3];
r4 [shape=diamond,label="defines",fillcolor="#fff5df",style=filled,fontsize=12,margin="0.08,0.06"];
blood_group -> r4 [label="(0,N)",color="#75899d",weight=3];
r4 -> blood_unit [label="(1,1)",color="#75899d:#75899d",weight=3];
r5 [shape=diamond,label="stores",fillcolor="#fff5df",style=filled,fontsize=12,margin="0.08,0.06"];
storage -> r5 [label="(0,N)",color="#75899d",weight=3];
r5 -> blood_unit [label="(1,1)",color="#75899d:#75899d",weight=3];
r6 [shape=diamond,label="undergoes",fillcolor="#fff5df",style=filled,fontsize=12,margin="0.08,0.06"];
blood_unit -> r6 [label="(0,N)",color="#75899d",weight=3];
r6 -> blood_test [label="(1,1)",color="#75899d:#75899d",weight=3];
r7 [shape=diamond,label="performs",fillcolor="#fff5df",style=filled,fontsize=12,margin="0.08,0.06"];
staff -> r7 [label="(0,N)",color="#75899d",weight=3];
r7 -> blood_test [label="(1,1)",color="#75899d:#75899d",weight=3];
}