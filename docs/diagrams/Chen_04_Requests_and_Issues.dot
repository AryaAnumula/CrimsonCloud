digraph er {
graph [bgcolor="white",fontname="Arial",fontsize=22,pad="0.5",nodesep="0.38",ranksep="0.8",splines=polyline,overlap=false, dpi=100,rankdir=LR,labelloc=t,labeljust=l,
label="BLOOD BANK MANAGEMENT SYSTEM\n04 / Hospitals, requests and issuance attributes\n\nChen notation: rectangle = entity | diamond = relationship | ellipse = attribute | underline = primary key\n(min,max) gives participation; double line = mandatory. Gray entities are references to another sheet."];
node [fontname="Arial",fontsize=14,color="#486078",penwidth=1.3]; edge [fontname="Arial",fontsize=12,color="#75899d",penwidth=1.1,dir=none];
hospital [shape=box,style="filled",fillcolor="#e5f2fc",label="HOSPITAL",margin="0.18,0.12"];
