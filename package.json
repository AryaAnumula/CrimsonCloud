{
  "name": "blood-bank-management-system",
  "version": "4.0.0",
  "description": "Blood bank DBMS mini-project: MySQL + MongoDB with a functional local Next.js interface",
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:setup": "node scripts/setup.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:dictionary": "node scripts/export-dictionary.mjs",
    "db:reconcile": "node scripts/reconcile.mjs",
    "db:sample": "node scripts/sample-data.mjs"
  },
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.9",
    "mongodb": "7.7.0",
    "mysql2": "3.24.6",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  }
}
