# Run npm run configure to create .env and random demo-login passwords.
# Replace YOUR_MYSQL_PASSWORD with your actual local MySQL password.
# URL-encode special characters in the password, e.g. @ becomes %40.
DATABASE_URL=mysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/blood_bank
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=blood_bank
ADMIN_PASSWORD=
STAFF_PASSWORD=
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
